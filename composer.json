{
    "name": "khalequzzaman17/qa-toolkit",
    "description": "Website Launch QA Toolkit for Laravel - pre-launch functional, security, performance, and infrastructure checks as Artisan commands, test stubs, and CI pipelines.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "qa", "testing", "security", "performance", "launch", "checklist", "ci", "pre-launch", "audit"],
    "homepage": "https://github.com/khalequzzaman17/qa-toolkit",
    "support": {
        "issues": "https://github.com/khalequzzaman17/qa-toolkit/issues",
        "source": "https://github.com/khalequzzaman17/qa-toolkit"
    },
    "authors": [
        {
            "name": "Khalequzzaman",
            "homepage": "https://github.com/khalequzzaman17"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/console": "^10.0 || ^11.0",
        "illuminate/support": "^10.0 || ^11.0",
        "illuminate/database": "^10.0 || ^11.0",
        "illuminate/filesystem": "^10.0 || ^11.0"
    },
    "require-dev": {
        "pestphp/pest": "^2.0 || ^3.0",
        "pestphp/pest-plugin-laravel": "^2.0 || ^3.0",
        "orchestra/testbench": "^8.0 || ^9.0"
    },
    "autoload": {
        "psr-4": {
            "QaToolkit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "QaToolkit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "QaToolkit\\QaToolkitServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
